{
  "manifest_version": 3,
  "name": "Tab Shelf",
  "version": "1.0.0",
  "description": "Save every open tab in one click, and keep auto-saved snapshots, for the Tab Shelf web app. Nothing leaves your computer.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Tab Shelf",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "externally_connectable": {
    "matches": [
      "https://billyl0uis.github.io/30dayassignment/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
