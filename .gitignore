# dependencies, build output and caches (per-project .gitignores may repeat these)
node_modules/
dist/
.venv/
__pycache__/
*.pyc
*.tsbuildinfo
.DS_Store

# Claude Code worktrees are separate git checkouts
.claude/worktrees/

# local secrets — never commit
.env
.env.*
!.env.example

# Tab Shelf: exported tab backups are private, never commit them
tabs-*.json
tab-shelf-*.json
# extension signing keys (only the public key belongs in manifest.json)
*.pem
*.crx
